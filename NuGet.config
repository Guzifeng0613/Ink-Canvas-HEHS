<?xml version="1.0" encoding="utf-8"?>
<!--
  The machine-level NuGet config may declare no package sources at all, which makes
  restore fail with NU1100. Declare the source in-repo so any clone restores.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>