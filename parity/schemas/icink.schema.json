{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "parity/schemas/icink.schema.json",
  "title": "icink",
  "type": "object",
  "properties": {
    "Version": {
      "type": "number"
    },
    "Strokes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Color": {
            "type": "number"
          },
          "Width": {
            "type": "number"
          },
          "Highlighter": {
            "type": "boolean"
          },
          "HighlighterAlpha": {
            "type": "number"
          },
          "Taper": {
            "type": "number"
          },
          "Shape": {
            "type": "boolean"
          },
          "ObjectFrame": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "Points": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          }
        },
        "required": [
          "Color",
          "Width",
          "Highlighter",
          "HighlighterAlpha",
          "Taper",
          "Shape",
          "ObjectFrame",
          "Points"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "Version",
    "Strokes"
  ],
  "additionalProperties": false
}
