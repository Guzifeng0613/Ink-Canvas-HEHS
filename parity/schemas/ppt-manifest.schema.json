{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "parity/schemas/ppt-manifest.schema.json",
  "title": "ppt-manifest",
  "type": "object",
  "properties": {
    "Version": {
      "type": "number"
    },
    "LastSlideIndex": {
      "type": "number"
    },
    "LastShowPosition": {
      "type": "number"
    },
    "Slides": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "SlideId": {
            "type": "number"
          },
          "SlideIndex": {
            "type": "number"
          },
          "File": {
            "type": "string"
          }
        },
        "required": [
          "SlideId",
          "SlideIndex",
          "File"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "Version",
    "LastSlideIndex",
    "LastShowPosition",
    "Slides"
  ],
  "additionalProperties": false
}
