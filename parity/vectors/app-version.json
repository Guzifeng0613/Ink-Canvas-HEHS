        "minor": 0,
        "patch": 0,
        "build": 0,
        "formatted": ""
      },
      "tolerance": 0
    },
    {
      "id": "compare-3.0.0.0-3.0.1.0",
      "fn": "compareVersions",
      "input": [
        [
          3,
          0,
          0,
          0
        ],
        [
          3,
          0,
          1,
          0
        ]
      ],
      "expected": -1,
      "tolerance": 0
    },
    {
      "id": "compare-3.1.0.0-3.0.9.9",
      "fn": "compareVersions",
