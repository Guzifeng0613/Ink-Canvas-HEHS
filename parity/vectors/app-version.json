{
  "id": "app-version",
  "entry": "harmony/core/src/main/ets/versioning/AppVersion.ts",
  "cases": [
    {
      "id": "parse-3.0.0",
      "fn": "parseVersion",
      "input": [
        "3.0.0"
      ],
      "expected": {
        "ok": true,
        "major": 3,
        "minor": 0,
        "patch": 0,
        "build": 0,
        "formatted": "3.0.0"
      },
      "tolerance": 0
    },
    {
      "id": "parse-v3.1.2",
      "fn": "parseVersion",
      "input": [
        "v3.1.2"
      ],
      "expected": {
        "ok": true,
        "major": 3,
        "minor": 1,
        "patch": 2,
        "build": 0,
        "formatted": "3.1.2"
      },
      "tolerance": 0
    },
    {
      "id": "parse-V26.10.7",
      "fn": "parseVersion",
      "input": [
        "V26.10.7"
      ],
      "expected": {
        "ok": true,
        "major": 26,
        "minor": 10,
        "patch": 7,
        "build": 0,
        "formatted": "26.10.7"
      },
      "tolerance": 0
    },
    {
      "id": "parse-1.2.3.4",
