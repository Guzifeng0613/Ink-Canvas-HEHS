      "id": "parse--1.2",
      "fn": "parseVersion",
      "input": [
        "-1.2"
      ],
      "expected": {
        "ok": false,
        "major": 0,
        "minor": 0,
        "patch": 0,
        "build": 0,
        "formatted": ""
      },
      "tolerance": 0
    },
    {
      "id": "parse-3.x.0",
      "fn": "parseVersion",
      "input": [
        "3.x.0"
      ],
      "expected": {
        "ok": false,
        "major": 0,
        "minor": 0,
        "patch": 0,
        "build": 0,
        "formatted": ""
      },
      "tolerance": 0
    },
    {
      "id": "parse-__v2.5__",
      "fn": "parseVersion",
      "input": [
