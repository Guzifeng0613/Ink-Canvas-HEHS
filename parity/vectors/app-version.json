    {
      "id": "compare-0.0.0.0-0.0.0.1",
      "fn": "compareVersions",
      "input": [
        [
          0,
          0,
          0,
          0
        ],
        [
          0,
          0,
          0,
          1
        ]
      ],
      "expected": -1,
      "tolerance": 0
