      "expected": {
        "ok": false,
        "major": 0,
        "minor": 0,
        "patch": 0,
        "build": 0,
        "formatted": ""
      },
      "tolerance": 0
    },
    {
      "id": "parse-1.2.3.4.5",
      "fn": "parseVersion",
      "input": [
