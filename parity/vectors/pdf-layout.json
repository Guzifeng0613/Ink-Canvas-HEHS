        5
      ],
      "expected": [
        1,
        2
      ],
      "tolerance": 0
    },
    {
      "id": "range-over-capacity",
      "fn": "pdfRangeProbe",
      "input": [
        "1-9",
        10,
        5
      ],
      "expected": "ERROR:所选页数超过画板剩余容量。",
      "tolerance": 0
    },
    {
      "id": "range-beyond-page-count",
      "fn": "pdfRangeProbe",
      "input": [
        "11",
        10,
        5
      ],
      "expected": "ERROR:页码范围无效，请输入 1-5,8 这样的范围。",
      "tolerance": 0
    },
    {
      "id": "range-empty",
      "fn": "pdfRangeProbe",
      "input": [
        ",,",
        10,
        5
      ],
      "expected": "ERROR:请至少选择一页。",
      "tolerance": 0
    },
