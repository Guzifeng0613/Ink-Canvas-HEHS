{
  "id": "pdf-layout",
  "entry": "harmony/core/src/main/ets/pdf/PdfLayout.ts",
  "cases": [
    {
      "id": "geometry-portrait-identity",
      "fn": "pdfGeometryProbe",
      "input": [
        0,
        0,
        612,
        792,
        0,
        1
      ],
      "expected": {
        "DipWidth": 816,
        "DipHeight": 1056,
        "ToPdf": [
          72,
          756
        ],
        "FromPdf": [
          96,
          48
        ]
      },
      "tolerance": 1e-06
    },
    {
      "id": "geometry-landscape-rotation-90",
      "fn": "pdfGeometryProbe",
      "input": [
        0,
        0,
        612,
        792,
        90,
        1
      ],
      "expected": {
        "DipWidth": 1056,
        "DipHeight": 816,
        "ToPdf": [
          36,
          72
        ],
        "FromPdf": [
          1008,
          96
        ]
      },
      "tolerance": 1e-06
    },
    {
      "id": "geometry-rotation-180",
      "fn": "pdfGeometryProbe",
      "input": [
        0,
        0,
        612,
        792,
        180,
        1
      ],
      "expected": {
        "DipWidth": 816,
        "DipHeight": 1056,
