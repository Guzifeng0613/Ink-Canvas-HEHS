        0,
        0,
        306,
        396,
        0,
        2
      ],
      "expected": {
        "DipWidth": 816,
        "DipHeight": 1056,
        "ToPdf": [
          36,
          378
        ],
        "FromPdf": [
          192,
          96
        ]
      },
      "tolerance": 1e-06
    },
    {
      "id": "range-basic",
      "fn": "pdfRangeProbe",
      "input": [
        "1-3,5",
        10,
        5
      ],
      "expected": [
        0,
        1,
        2,
        4
      ],
      "tolerance": 0
