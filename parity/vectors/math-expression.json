{
  "id": "math-expression",
  "entry": "harmony/features/src/main/ets/analytic/MathExpression.ts",
  "cases": [
    {
      "id": "normalize-superscript-and-symbols",
      "fn": "expressionNormalizeProbe",
      "input": [
        "x²−y×3÷2"
      ],
      "expected": "x^2-y*3/2",
      "tolerance": 0
    },
    {
      "id": "normalize-pi-theta",
      "fn": "expressionNormalizeProbe",
      "input": [
        "π×θ"
      ],
      "expected": "pi*t",
      "tolerance": 0
    },
    {
      "id": "quadratic-with-params",
      "fn": "expressionEvaluateProbe",
      "input": [
        "a*x^2+b*x+c",
        2,
        0,
        0,
        1,
        -3,
        2
      ],
      "expected": 0,
      "tolerance": 1E-09
    },
    {
      "id": "implicit-multiplication",
      "fn": "expressionEvaluateProbe",
      "input": [
        "2x",
        3,
        0,
        0,
        0,
        0,
        0
      ],
      "expected": 6,
      "tolerance": 1E-09
    },
    {
      "id": "multi-letter-product",
      "fn": "expressionEvaluateProbe",
      "input": [
        "xy",
        3,
        4,
        0,
        0,
        0,
        0
      ],
      "expected": 12,
      "tolerance": 1E-09
    },
    {
      "id": "pi-and-e",
      "fn": "expressionEvaluateProbe",
      "input": [
        "pi+e",
        0,
        0,
        0,
        0,
        0,
        0
      ],
      "expected": 5.859874482048838,
      "tolerance": 1E-09
    },
    {
      "id": "unary-minus-and-power",
      "fn": "expressionEvaluateProbe",
      "input": [
        "-x^2",
        3,
        0,
        0,
        0,
        0,
        0
      ],
      "expected": -9,
      "tolerance": 1E-09
    },
    {
      "id": "functions",
      "fn": "expressionEvaluateProbe",
      "input": [
        "sin(pi/2)+max(3,4)+atan2(1,1)",
        0,
        0,
        0,
        0,
        0,
        0
      ],
      "expected": 5.785398163397448,
      "tolerance": 1E-09
    },
    {
      "id": "depth-and-variables",
      "fn": "expressionEvaluateProbe",
      "input": [
        "((x+(a-b)))*t",
        1,
        0,
        2,
        5,
        2,
        0
      ],
      "expected": 8,
      "tolerance": 1E-09
    },
    {
      "id": "exp-notation",
      "fn": "expressionEvaluateProbe",
      "input": [
        "2e2",
        0,
        0,
        0,
        0,
        0,
        0
      ],
      "expected": 200,
      "tolerance": 1E-09
    },
    {
      "id": "error-unknown-name",
      "fn": "expressionEvaluateProbe",
      "input": [
        "foo(x)",
        0,
        0,
        0,
        0,
        0,
        0
      ],
      "expected": "ERROR:未知名称 foo",
      "tolerance": 0
    },
    {
      "id": "error-unbalanced",
      "fn": "expressionEvaluateProbe",
      "input": [
        "(x+1",
        0,
        0,
        0,
        0,
        0,
        0
      ],
      "expected": "ERROR:缺少右括号",
      "tolerance": 0
    },
    {
      "id": "error-unsupported-char",
      "fn": "expressionEvaluateProbe",
      "input": [
        "x@y",
        0,
        0,
        0,
        0,
        0,
        0
      ],
      "expected": "ERROR:不支持的字符 @",
      "tolerance": 0
    },
    {
      "id": "error-too-long",
      "fn": "expressionEvaluateProbe",
      "input": [
        "",
        0,
        0,
        0,
        0,
        0,
        0
      ],
      "expected": "ERROR:公式嵌套过深",
      "tolerance": 0
    }
  ]
}
