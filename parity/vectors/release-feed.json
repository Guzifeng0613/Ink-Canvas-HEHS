{
  "id": "release-feed",
  "entry": "harmony/core/src/main/ets/update/ReleaseFeed.ts",
  "cases": [
    {
      "id": "latest-setup",
      "fn": "parseLatestSummary",
      "input": [
        "{\"tag_name\":\"v3.5.0\",\"name\":\"3.5.0\",\"body\":\"notes\",\"html_url\":\"https://example/rel\",\"assets\":[{\"name\":\"InkCanvas-Setup-3.5.0.exe\",\"browser_download_url\":\"https://example/setup.exe\",\"size\":12345}]}"
      ],
      "expected": {
        "Tag": "v3.5.0",
        "Version": [
          3,
          5,
          0,
          0
        ],
        "Name": "3.5.0",
        "Notes": "notes",
        "PageUrl": "https://example/rel",
        "InstallerUrl": "https://example/setup.exe",
        "InstallerSize": 12345
      },
      "tolerance": 0
    },
    {
      "id": "latest-fallback-exe",
      "fn": "parseLatestSummary",
      "input": [
        "{\"tag_name\":\"3.4.1\",\"name\":\"3.4.1\",\"body\":\"b\",\"html_url\":\"https://example/rel2\",\"assets\":[{\"name\":\"other.exe\",\"browser_download_url\":\"https://example/other.exe\",\"size\":100},{\"name\":\"InkCanvas.exe\",\"browser_download_url\":\"https://example/app.exe\",\"size\":200}]}"
      ],
      "expected": {
        "Tag": "3.4.1",
        "Version": [
          3,
          4,
          1,
          0
        ],
        "Name": "3.4.1",
        "Notes": "b",
        "PageUrl": "https://example/rel2",
        "InstallerUrl": "https://example/other.exe",
        "InstallerSize": 100
      },
      "tolerance": 0
    },
    {
      "id": "latest-no-exe",
      "fn": "parseLatestSummary",
      "input": [
        "{\"tag_name\":\"3.4.2\",\"name\":\"3.4.2\",\"assets\":[{\"name\":\"readme.txt\",\"browser_download_url\":\"https://example/readme.txt\"}]}"
      ],
      "expected": null,
      "tolerance": 0
    },
    {
      "id": "latest-invalid",
      "fn": "parseLatestSummary",
      "input": [
        "not json"
      ],
      "expected": null,
      "tolerance": 0
    },
    {
      "id": "newest-stable",
      "fn": "parseNewestStableSummary",
      "input": [
        "[{\"tag_name\":\"v9.0.0\",\"draft\":true},{\"tag_name\":\"v8.0.0\",\"prerelease\":true},{\"tag_name\":\"v3.1.0\",\"name\":\"a\",\"assets\":[{\"name\":\"setup.exe\",\"browser_download_url\":\"https://example/a.exe\",\"size\":1}]},{\"tag_name\":\"v3.2.0\",\"name\":\"b\",\"assets\":[{\"name\":\"setup.exe\",\"browser_download_url\":\"https://example/b.exe\",\"size\":2}]}]"
      ],
      "expected": {
        "Tag": "v3.2.0",
        "Version": [
          3,
          2,
          0,
          0
        ],
        "Name": "b",
        "Notes": "",
        "PageUrl": "",
        "InstallerUrl": "https://example/b.exe",
        "InstallerSize": 2
      },
      "tolerance": 0
    },
    {
      "id": "newest-invalid",
      "fn": "parseNewestStableSummary",
      "input": [
        "{}"
      ],
      "expected": null,
      "tolerance": 0
    }
  ]
}
