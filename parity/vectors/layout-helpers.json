      "tolerance": 1e-9
    },
    {
      "id": "dock-scale-clamp",
      "fn": "boardDockLayout",
      "input": [1920, 2, 200, 300, 150],
      "expected": { "Scale": 1.5, "TwoRows": false, "Height": 82.5 },
      "tolerance": 1e-9
    },
    {
      "id": "dock-two-rows-scaled",
      "fn": "boardDockLayout",
      "input": [600, 1.5, 200, 300, 150],
      "expected": { "Scale": 1.5, "TwoRows": true, "Height": 171 },
      "tolerance": 1e-9
    }
  ]
